            <div class="card text-center">
                <div class="card-title" style="justify-content: center;"><i class="fas fa-dharmachakra"></i> Lucky Domain Spin</div>
                <p style="font-size: 14px; font-weight: 900; color: var(--primary); margin-bottom: 20px;">Domains: <span id="uiDomainBal">0</span></p>
                <div style="font-size: 70px; margin: 20px 0; text-shadow: 0 0 30px var(--primary);">🎡</div>
                <button class="btn btn-primary" onclick="spinWheel()">SPIN NOW (1 Domain)</button>
                
                <div style="margin-top: 20px; display: flex; justify-content: space-between; gap: 10px;">
                    <button class="btn btn-payu" style="font-size: 12px; padding: 12px;" onclick="buyDomains(10)">Buy 5 Domains (₹10)</button>
                    <button class="btn btn-outline" id="freeSpinBtn" style="font-size: 12px; padding: 12px;" onclick="spinFree()">Free Spin (5/5)</button>
                </div>
            </div>
        </div>

        <div id="view-vip" class="view-section">
            <h2 style="text-align:center; margin-bottom:20px; color:var(--primary);">VIP MEMBERSHIP</h2>
            <div class="card text-center" style="border-color: #d4af37;">
                <h3>VIP Level 1</h3>
