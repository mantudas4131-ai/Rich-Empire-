            </div>
        </div>

        <div id="view-refer" class="view-section">
            <div class="card text-center">
                <div class="card-title" style="justify-content: center;"><i class="fas fa-users"></i> Refer &amp; Earn</div>
                <p style="font-size: 12px; margin-bottom: 15px;">Invite friends via Telegram! Get Commission on their 1st Deposit.</p>
                <div style="background: #000; padding: 15px; border-radius: 8px; color: var(--accent); font-family: monospace; font-size: 14px; margin-bottom: 15px;">
                    https://t.me/YourBotID?start=ref12345
                </div>
                <button class="btn btn-primary" onclick="window.open('https://t.me/share/url?url=https://t.me/YourBotID?start=ref12345&amp;text=Join%20Rich%20Empire%20and%20Earn!', '_blank')">SHARE ON TELEGRAM</button>
            </div>
        </div>

        <div id="view-wallet" class="view-section">
            <div class="card text-center">
                <h2>Total Balance</h2>
                <h1 style="color: var(--primary); font-size: 36px; margin: 10px 0;">₹ <span id="uiWalletInr">0.00</span></h1>
                <p style="color: var(--success); font-weight: 700;"><i class="fas fa-coins"></i> <span id="uiWalletPts">0</span> Points</p>
                
                <div style="display: flex; gap: 15px; margin-top: 20px;">
                    <button class="btn btn-payu" onclick="navTo('view-deposit')"><i class="fas fa-plus"></i> DEPOSIT</button>
                    <button class="btn btn-danger" onclick="navTo('view-withdraw')"><i class="fas fa-minus"></i> WITHDRAW</button>
                </div>
            </div>
            
            <div class="card">
                <div class="card-title">Points Exchange</div>
                <p style="font-size: 12px; margin-bottom: 10px;">50,000 Points = ₹10</p>
                <button class="btn btn-outline" onclick="exchangePoints()">Convert Points to ₹</button>
            </div>
        </div>

        <div id="view-withdraw" class="view-section">
            <div class="card">
                <div class="card-title"><i class="fas fa-university"></i> Withdraw Funds</div>
                <p style="font-size: 12px; color: var(--danger); margin-bottom: 15px;">Note: Min ₹1000 required. ₹120 Fee applies.</p>
                <input type="text" placeholder="Bank Name" />
                <input type="number" placeholder="Account Number" />
                <input type="text" placeholder="IFSC Code" />
                <input type="text" placeholder="UPI ID (Optional)" />
                <input type="number" id="wdAmount" placeholder="Amount (Min ₹1000)" />
                <button class="btn btn-primary" onclick="requestWithdraw()">SUBMIT WITHDRAWAL</button>
                <button class="btn btn-outline" onclick="navTo('view-wallet')">Cancel</button>
            </div>
        </div>
        
        <div id="view-deposit" class="view-section">
            <div class="card text-center">
                <div class="card-title" style="justify-content: center;"><i class="fas fa-wallet"></i> Add Funds</div>
                <p style="font-size: 12px; margin-bottom: 15px;">Secure payments powered by PayU.</p>
                <button class="btn btn-payu" onclick="depositAmt(30)">Add ₹ 30</button>
                <button class="btn btn-payu" onclick="depositAmt(100)">Add ₹ 100</button>
                <button class="btn btn-payu" onclick="depositAmt(500)">Add ₹ 500</button>
                <button class="btn btn-payu" onclick="depositAmt(1000)">Add ₹ 1000</button>
                <button class="btn btn-payu" onclick="depositAmt(5000)">Add ₹ 5000</button>
                <button class="btn btn-outline" onclick="navTo('view-wallet')">Back</button>
            </div>
        </div>

        <div id="view-history" class="view-section">
            <div class="card">
                <div class="card-title">Transaction History</div>
                <ul id="historyList" style="list-style: none; font-size: 12px;">
                    <li style="padding: 10px 0; border-bottom: 1px solid #333;">No transactions yet.</li>
                </ul>
            </div>
        </div>

        <div id="view-offers" class="view-section">
            <div class="card">
                <div class="card-title">My Daily Offers</div>
                <div id="offersList" style="font-size: 12px; color: #aaa;">
                    No active packages.
                </div>
            </div>
        </div>
        
    </div>

    <div class="bottom-nav">
        <div class="nav-item active" onclick="navTo('view-home', this)"><i class="fas fa-home"></i>Home</div>
        <div class="nav-item" onclick="navTo('view-games', this)"><i class="fas fa-gamepad"></i>Games</div>
        <div class="nav-item" onclick="navTo('view-refer', this)"><i class="fas fa-users"></i>Refer</div>
        <div class="nav-item" onclick="navTo('view-vip', this)"><i class="fas fa-crown"></i>VIP</div>
        <div class="nav-item" onclick="navTo('view-wallet', this)"><i class="fas fa-wallet"></i>Wallet</div>
    </div>
    
    <script>
        // Data Variables
        let balInr = 0.00;
        let balPts = 0;
        let balDomains = 0;
        let curBet = 100;
        let isVip = 0;
        let activeDays = 0; 
        let freeSpinsLeft = 5;
        let bonusClaimed = false;
        
        // Init Telegram
        const tg = window.Telegram ? window.Telegram.WebApp : null;
        if(tg && tg.initDataUnsafe && tg.initDataUnsafe.user) {
            document.getElementById('userName').innerText = tg.initDataUnsafe.user.first_name;
            if(tg.initDataUnsafe.user.photo_url) {
                document.getElementById('userPhoto').src = tg.initDataUnsafe.user.photo_url;
            }
        }
        
        // Random Ticket Number
        document.getElementById('ticketNum').innerText = "RE-" + Math.floor(10000 + Math.random() * 90000);

        function updateUI() {
            document.getElementById('uiInr').innerText = balInr.toFixed(2);
            document.getElementById('uiWalletInr').innerText = balInr.toFixed(2);
            document.getElementById('uiPts').innerText = balPts;
            document.getElementById('uiWalletPts').innerText = balPts;
            document.getElementById('uiDomainBal').innerText = balDomains;
            document.getElementById('uiCurBet').innerText = curBet;
            document.getElementById('freeSpinBtn').innerText = `Free Spin (${freeSpinsLeft}/5)`;
        }

        function addHistory(text) {
            const list = document.getElementById('historyList');
            if(list.innerHTML.includes('No transactions')) list.innerHTML = '';
            list.innerHTML = `<li style="padding: 10px 0; border-bottom: 1px solid #333;">${text}</li>` + list.innerHTML;
        }

        function navTo(id, el = null) {
            document.querySelectorAll('.view-section').forEach(v => v.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            if(el) {
                document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
                el.classList.add('active');
            }
            window.scrollTo(0, 0);
        }

        function toggleMenu() {
            document.getElementById('sideMenu').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('active');
        }

        // Home Functions
        function claimDailyBonus() {
            if(bonusClaimed) { alert("You have already claimed today's UPI Cash!"); return; }
            let rewards = [1, 5, 10, 20];
            let bonus = rewards[Math.floor(Math.random() * rewards.length)];
            balInr += bonus;
            bonusClaimed = true;
            alert(`Congratulations! You received ₹${bonus} UPI Cash!`);
            addHistory(`Daily Super Card: +₹${bonus}`);
            updateUI();
        }

        function buyLottery(amt) {
            if(balInr < amt) { alert("Insufficient Balance. Please Deposit."); navTo('view-deposit'); return; }
            balInr -= amt;
            let winChance = Math.random();
            if(winChance > 0.6) { 
                let multi = Math.floor(Math.random() * 4) + 3; // 3x to 6x
                let winAmt = amt * multi;
                balInr += winAmt;
                alert(`JACKPOT! You won ₹${winAmt} (${multi}x)!`);
                addHistory(`Lottery Won: +₹${winAmt}`);
            } else {
                alert("Better luck next hour!");
                addHistory(`Lottery Lost: -₹${amt}`);
            }
            updateUI();
        }

        function buyPackage(amt, dailyAmt) {
            if(balInr < amt) { alert("Insufficient Balance. Please Deposit via PayU."); navTo('view-deposit'); return; }
            balInr -= amt;
            let list = document.getElementById('offersList');
            if(list.innerHTML.includes('No active')) list.innerHTML = '';
            list.innerHTML += `<div style="padding: 10px; border: 1px solid var(--success); margin-bottom: 10px; border-radius: 8px;">
                <p style="color:var(--success); font-weight: bold;">₹${amt} Package Active!</p>
                <p>Receiving ₹${dailyAmt}/day (7 Days Left)</p>
            </div>`;
            alert(`Package of ₹${amt} activated!`);
            addHistory(`Bought Package: -₹${amt}`);
            updateUI();
        }

        // Games Functions
        function buyPoints(inrAmt, ptsAmt) {
            if(balInr < inrAmt) { alert("Insufficient balance."); return; }
            balInr -= inrAmt;
            balPts += ptsAmt;
            alert(`Successfully bought ${ptsAmt} Points!`);
            updateUI();
        }

        function setBet(amt) { curBet = amt; updateUI(); }
        
        function initHT() {
            const grid = document.getElementById('htGrid');
            grid.innerHTML = '';
            for(let i=0; i<16; i++) {
                let box = document.createElement('div');
                box.className = 'ht-box';
                box.innerHTML = '🪙';
                box.onclick = () => playHT(box);
                grid.appendChild(box);
            }
        }
        
        function playHT(box) {
            if(box.classList.contains('win')) return;
            if(balPts < curBet) { alert("Not enough Points! Exchange ₹ for Points."); return; }
            balPts -= curBet;
            
            let rand = Math.random();
            if(rand > 0.7) { 
                let multi = [2, 3, 5, 10][Math.floor(Math.random() * 4)];
                let winAmt = curBet * multi;
                balPts += winAmt;
                box.classList.add('win');
                box.innerHTML = `${multi}x 🎉`;
                addHistory(`Jili Win: +${winAmt} Pts`);
            } else {
                box.innerHTML = '❌';
                addHistory(`Jili Loss: -${curBet} Pts`);
            }
            updateUI();
        }

        function spinWheel() {
            if(balDomains < 1) { alert("No domains! Buy domains or use Free Spin."); return; }
            balDomains -= 1;
            processSpin();
        }

        function spinFree() {
            if(freeSpinsLeft <= 0) { alert("No free spins left for today!"); return; }
            freeSpinsLeft -= 1;
            processSpin();
        }

        function processSpin() {
            let rewards = [
                {type: 'pts', val: 100}, {type: 'pts', val: 500}, {type: 'pts', val: 1000},
                {type: 'amazon', val: 'Amazon Gift Card'}, {type: 'upi', val: '₹50 UPI Cash'},
                {type: 'domain', val: '2 Extra Domains'}
            ];
            let won = rewards[Math.floor(Math.random() * rewards.length)];
            
            if(won.type === 'pts') {
                balPts += won.val;
                alert(`🎡 You won ${won.val} Points!`);
            } else if (won.type === 'domain') {
                balDomains += 2;
                alert(`🎡 You won 2 Extra Domains! Spin again.`);
            } else {
                alert(`🎡 WOW! You won a ${won.val}! Admin will contact you.`);
            }
            addHistory(`Spin Result: ${won.val}`);
            updateUI();
        }

        function buyDomains(amt) {
            if(balInr < amt) { alert("Insufficient balance."); return; }
            balInr -= amt;
            balDomains += 5;
            alert("Bought 5 Domains!");
            updateUI();
        }

        // Wallet & VIP Functions
        function depositAmt(amt) {
            balInr += amt;
            alert(`Successfully deposited ₹${amt} via PayU (Demo)`);
            addHistory(`Deposit: +₹${amt}`);
            updateUI();
            navTo('view-wallet');
        }

        function requestWithdraw() {
            let amt = parseInt(document.getElementById('wdAmount').value);
            if(!amt || amt < 1000) { alert("Minimum withdrawal is ₹1000"); return; }
            if(balInr < amt) { alert("Insufficient balance"); return; }
            if(activeDays < 7 && isVip === 0) { 
                alert(`Cannot withdraw! You need 7 days active. Current: ${activeDays} Days.`); 
                return; 
            }
            balInr -= amt;
            alert(`Withdrawal of ₹${amt - 120} (after ₹120 fee) submitted!`);
            addHistory(`Withdrawal: -₹${amt}`);
            updateUI();
            navTo('view-wallet');
        }
        
        function buyVIP(level, price) {
            if(balInr < price) { alert("Insufficient Balance. Deposit first."); navTo('view-deposit'); return; }
            balInr -= price;
            isVip = level;
            alert(`Congratulations! You are now VIP Level ${level}`);
            addHistory(`Upgraded to VIP ${level}: -₹${price}`);
            updateUI();
        }

        function exchangePoints() {
            if(balPts < 50000) { alert("Minimum 50,000 points required to convert."); return; }
            balPts -= 50000;
            balInr += 10;
            alert("50,000 Points converted to ₹10!");
            updateUI();
        }

        // Start App
        initHT();
        updateUI();
    </script>
</body>
</html>
