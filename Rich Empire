            <li onclick="navTo('view-history'); toggleMenu();"><i class="fas fa-history"></i> Transaction History</li>
            <li onclick="navTo('view-offers'); toggleMenu();"><i class="fas fa-chart-line"></i> My Daily Offers</li>
