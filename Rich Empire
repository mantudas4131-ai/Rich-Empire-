            <li onclick="alert('About Us: Rich Empire is a premium gaming and earning app ensuring secure transactions.')"><i class="fas fa-info-circle"></i> About Us</li>
            <li onclick="alert('Privacy Policy: We securely encrypt your Telegram ID and payment data.')"><i class="fas fa-shield-alt"></i> Privacy Policy</li>
            <li onclick="window.open('https://t.me/YourBotID', '_blank')"><i class="fas fa-headset"></i> Contact Telegram Bot</li>
