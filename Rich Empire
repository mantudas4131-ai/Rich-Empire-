<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Rich Empire - Play & Earn</title>
    
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet"/>
    
    <style>
        /* =========================================
           RICH EMPIRE - GLOBAL CSS
           ========================================= */
        :root { 
            --bg: #0b0b13; 
            --card: #151520; 
            --primary: #f5c518; 
            --accent: #00e5ff; 
            --danger: #ff3b30; 
            --success: #34c759; 
            --text: #ffffff; 
            --text-muted: #8e8e93;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; }
        body { background: var(--bg); color: var(--text); padding-bottom: 70px; -webkit-tap-highlight-color: transparent; overflow-x: hidden;}
        
        /* HEADER */
        .header { background: rgba(21, 21, 32, 0.95); backdrop-filter: blur(10px); padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; border-bottom: 1px solid #2a2a35; }
        .user-profile { display: flex; align-items: center; gap: 12px; }
        .user-profile img { width: 45px; height: 45px; border-radius: 50%; border: 2px solid var(--primary); object-fit: cover; }
        .user-info h4 { font-size: 15px; margin-bottom: 3px; font-weight: 700; color: #fff;}
        .user-info p { font-size: 12px; color: var(--success); font-weight: 700; display: flex; gap: 10px;}
        .menu-icon { font-size: 24px; color: var(--primary); cursor: pointer; }
        
        /* BOTTOM NAVIGATION */
        .bottom-nav { position: fixed; bottom: 0; width: 100%; background: #11111a; display: flex; justify-content: space-around; padding: 12px 0; border-top: 1px solid #2a2a35; z-index: 90; }
        .nav-item { color: var(--text-muted); font-size: 11px; text-align: center; font-weight: 700; text-transform: uppercase; cursor: pointer; width: 20%; }
        .nav-item i { font-size: 22px; display: block; margin-bottom: 4px; transition: 0.3s;}
        .nav-item.active { color: var(--primary); }
        .nav-item.active i { transform: translateY(-3px); }

        /* VIEWS & CARDS */
        .view-section { display: none; padding: 20px; animation: fadeIn 0.4s ease; }
        .view-section.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
        
        .card { background: var(--card); border-radius: 16px; padding: 20px; margin-bottom: 20px; border: 1px solid #2a2a35; box-shadow: 0 4px 10px rgba(0,0,0,0.5);}
        .card-title { font-size: 16px; font-weight: 700; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; color: var(--primary); text-transform: uppercase; }
        
        /* BUTTONS */
        .btn { width: 100%; padding: 14px; border-radius: 12px; border: none; font-size: 14px; font-weight: 700; cursor: pointer; text-align: center; text-transform: uppercase; margin-top: 10px; transition: 0.2s;}
        .btn-primary { background: linear-gradient(90deg, #d4af37, #f5c518); color: #000; }
        .btn-payu { background: #00d285; color: #000; }
        .btn-outline { background: transparent; border: 1px solid var(--primary); color: var(--primary); }
        .btn-danger { background: var(--danger); color: #fff; }
        
        /* MENU */
        .side-menu { position: fixed; top: 0; right: -300px; width: 280px; height: 100vh; background: #11111a; border-left: 1px solid #2a2a35; z-index: 1000; transition: right 0.3s ease; padding: 20px; overflow-y: auto; }
        .side-menu.open { right: 0; }
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 999; display: none; }
        .overlay.active { display: block; }
        .menu-list { list-style: none; margin-top: 15px; }
        .menu-list li { padding: 15px 10px; border-bottom: 1px solid #222; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 15px; font-weight: 600;}
        .menu-list li i { color: var(--primary); font-size: 18px; width: 20px; }

        /* GAMES & FORMS */
        .ht-box { background: #222; aspect-ratio: 1; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 28px; border: 2px solid #333; cursor: pointer; transition: 0.2s;}
        .ht-box:hover { border-color: var(--primary); }
        .ht-box.win { border-color: var(--success); background: rgba(52, 199, 89, 0.1); color: var(--success); font-weight: 900; font-size: 18px;}
        input[type="text"], input[type="number"] { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #333; background: #0b0b13; color: #fff; margin-bottom: 15px; }
        .text-center { text-align: center; }
    </style>
</head>
<body>
    
    <header class="header">
        <div class="user-profile">
            <img id="userPhoto" src="https://via.placeholder.com/50" alt="Avatar"/>
            <div class="user-info">
                <h4>Welcome, <span id="userName">Guest</span></h4>
