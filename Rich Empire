                    <button class="btn btn-payu" onclick="buyPackage(1000, 250)"><i class="fas fa-bolt"></i> BUY VIA PAYU (₹1000)</button>
                </div>
                <div style="border: 1px solid #333; padding: 15px; border-radius: 10px; margin-top: 15px;">
                    <h3 style="color: var(--accent);">Package: ₹ 5000</h3>
                    <p style="font-size: 12px; margin: 5px 0;">Get <b style="color: #fff;">₹ 1300 / Day</b> for 7 Days.</p>
                    <button class="btn btn-payu" onclick="buyPackage(5000, 1300)"><i class="fas fa-bolt"></i> BUY VIA PAYU (₹5000)</button>
                </div>
            </div>
        </div>

        <div id="view-games" class="view-section">
            
            <div class="card">
                <div class="card-title"><i class="fas fa-shopping-cart"></i> Buy Game Points</div>
                <div style="display: flex; gap: 10px;">
                    <button class="btn btn-payu" style="font-size: 12px; padding: 10px;" onclick="buyPoints(10, 50000)">₹10 = 50K Pts</button>
                    <button class="btn btn-payu" style="font-size: 12px; padding: 10px;" onclick="buyPoints(50, 250000)">₹50 = 250K Pts</button>
                </div>
            </div>

            <div class="card">
                <div class="card-title"><i class="fas fa-th-large"></i> Jili Head &amp; Tail</div>
                <p style="font-size: 12px; color: #aaa; margin-bottom: 10px;">Find hidden multipliers (2x, 3x, 5x, 10x).</p>
                <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                    <button class="btn btn-outline" style="margin: 0; padding: 8px;" onclick="setBet(100)">100 Pts</button>
                    <button class="btn btn-outline" style="margin: 0; padding: 8px;" onclick="setBet(500)">500 Pts</button>
                    <button class="btn btn-outline" style="margin: 0; padding: 8px;" onclick="setBet(1000)">1000 Pts</button>
                </div>
                <p style="font-size: 13px; color: var(--primary); margin-bottom: 15px; font-weight: 700;">Current Bet: <span id="uiCurBet">100</span> Pts</p>
                <div id="htGrid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;"></div>
