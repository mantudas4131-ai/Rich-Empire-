                    <button class="btn btn-outline" style="padding: 10px; margin: 0;" onclick="buyLottery(200)">₹ 200</button>
                    <button class="btn btn-outline" style="padding: 10px; margin: 0;" onclick="buyLottery(500)">₹ 500</button>
                </div>
            </div>

            <div class="card">
                <div class="card-title"><i class="fas fa-fire" style="color: #ff3b30;"></i> Daily Offer Packages</div>
                <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 15px;">Deposit for 7 Days. Get Daily Returns + 10% Cash Back!</p>
                
